# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/trading_analysis

# Application Security
JWT_SECRET=supersecretjwtkeythatislongenoughforvalidation12345678901234567890
JWT_EXPIRATION_MS=86400000

# Market Data Engine Settings
MARKET_DATA_PROVIDER=MOCK
LIVE_TRADING_ENABLED=false

# External Provider APIs (Unused in MOCK mode)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
NEWS_API_KEY=

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Render Keep-Alive / Health Monitoring Settings
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=http://localhost:8080
KEEP_ALIVE_INTERVAL_MINUTES=14
